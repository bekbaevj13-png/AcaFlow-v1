{
  "name": "@acaflow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "prettier --check \"{src,tests,e2e,scripts,prisma}/**/*.{ts,tsx}\" && next typegen && tsc --noEmit",
    "format": "prettier --write \"{src,tests,e2e,scripts,prisma}/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:academic": "tsx prisma/seed-academic.ts",
    "db:seed:exams": "tsx prisma/seed-exams.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "fixtures": "tsx scripts/make-fixture.ts",
    "backup": "bash scripts/backup/backup.sh",
    "restore": "bash scripts/backup/restore.sh",
    "restore:verify": "tsx scripts/backup/verify-restore.ts",
    "restore:drill": "bash scripts/backup/restore-drill.sh",
    "tenant:export": "tsx scripts/backup/tenant-export.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-virtual": "3.14.26",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "dejavu-fonts-ttf": "2.37.3",
    "exceljs": "4.4.0",
    "jose": "6.2.15",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
